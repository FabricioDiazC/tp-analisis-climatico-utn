# Archivos temporales de Python
__pycache__/
*.py[cod]
*$py.class

# Checkpoints de Jupyter/Colab (no forman parte del código fuente)
.ipynb_checkpoints/

# Archivos de datos pesados (evitar sobrecargar el repositorio)
*.xlsx
*.zip

# Logs generados durante la ejecución
*.log

# Variables de entorno y credenciales
.env
*.pem
